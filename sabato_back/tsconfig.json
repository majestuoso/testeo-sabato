{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    
    /* Soporte para JavaScript secundario */
    "allowJs": true,
    "checkJs": false,
    
    /* Configuración de comprobación y tipos */
    "sourceMap": true,
    "strict": false,
    "skipLibCheck": true,
    "moduleDetection": "force"
  },
  "include": ["src/**/*", "server.ts", "crear_user.js"]
}