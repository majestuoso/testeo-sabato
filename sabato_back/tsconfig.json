{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    
    /* Soporte para JavaScript secundario (scripts o migraciones) */
    "allowJs": true,
    "checkJs": false,
    
    /* Configuración de compilación y tipos */
    "sourceMap": true,
    "strict": false,
    "skipLibCheck": true,
    "moduleDetection": "force"
  },
  "include": ["src/**/*", "server.ts", "crear_user.js"]
}